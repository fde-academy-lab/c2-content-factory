{
  "name": "C2 Content Factory",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/itsmechlark/features/postgresql:1": {
      "version": "16"
    }
  },
  "onCreateCommand": "bash setup.sh && bash .devcontainer/load_warehouse.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-ossdata.vscode-pgsql",
        "bierner.markdown-mermaid",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "files.trimTrailingWhitespace": true
      }
    }
  },
  "remoteEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "${containerEnv:HOME}/.cache/ms-playwright",
    "PIP_BREAK_SYSTEM_PACKAGES": "1",
    "PGHOST": "localhost",
    "PGPORT": "5432",
    "PGUSER": "postgres",
    "PGPASSWORD": "postgres",
    "PGDATABASE": "kalpa"
  },
  "postAttachCommand": "echo 'Ready. Warehouse: psql -c \"\\\\dt\". Prove a day pack with: python3 scripts/verify.py content/W02/D2 --execute'"
}

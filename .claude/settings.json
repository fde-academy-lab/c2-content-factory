{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*(merge_pull_request|enable_pr_auto_merge)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/day_branch_merge_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking that this session may merge"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 300,
            "statusMessage": "Pinning mermaid-cli 11.17.0"
          }
        ]
      }
    ]
  }
}
